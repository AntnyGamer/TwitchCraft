<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TwitchCraftBot_V1.Frames.Main" Background="Transparent" Foreground="White" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid ClipToBounds="True">
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush x:Name="Fade" StartPoint="0,3" EndPoint="0,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#DD000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><Grid Width="800" Height="450" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="True"><Image Opacity="0.5" Width="58" Stretch="Fill" Source="/Assets/TwitchLogo.png" Height="58" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="258,86,0,0">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <SkewTransform />
                        <RotateTransform Angle="35" />
                        <TranslateTransform />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Image Width="59" Opacity="0.5" Stretch="Fill" Source="/Assets/DiamondPickaxe.png" Height="58" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="268,263,0,0">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="-1" />
                        <SkewTransform />
                        <RotateTransform Angle="20" />
                        <TranslateTransform />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <Rectangle Width="121" Height="57" Fill="#FFA4A4A4" Margin="635,110,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Rectangle Width="121" Height="57" Fill="#FFA4A4A4" Margin="635,198,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Rectangle Width="121" Height="57" Fill="#FFA4A4A4" Margin="635,286,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Rectangle Width="121" Height="57" Fill="#FFA4A4A4" Margin="635,374,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

            <TextBlock FontFamily="Cascadia Mono" FontSize="27.75" Text="TwitchCraft Bot" Foreground="#FFFF1B1B" Margin="0,21,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="1" />
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="Created by AntnyGamer" FontFamily="Segoe UI Variable Display Semibold" FontSize="16" Foreground="#C6C6C6" Margin="614,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

            <TextBlock Text="Twitch Log:" FontFamily="Segoe UI Variable Display Semibold" FontSize="18" TextAlignment="Center" Margin="102,55,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

            <Border Width="268" Height="155" BorderBrush="#FF545454" BorderThickness="2" Margin="14,79,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">

                <TextBox x:Name="TwitchLogs" BorderThickness="0" Background="#F0F0F0" Foreground="Black" IsReadOnly="True" IsUndoEnabled="False" UndoLimit="0" FontFamily="Consolas" FontSize="8" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            </Border>

            <TextBlock x:Name="TwitchViewers" Width="170" Text="Twitch Viewer List:" FontFamily="Segoe UI Variable Display Semibold" FontSize="14" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="427,138,0,0" />

            <Border Width="180" Height="230" BorderBrush="#FF545454" BorderThickness="1" Background="White" Padding="2" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="422,162,0,0">

                <ListBox x:Name="BotViewerList" BorderBrush="#FF545454" BorderThickness="2" Background="Transparent" FontFamily="Consolas" FontSize="12" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" Margin="-3,-3,-3,-3" />
            </Border>

            <TextBlock x:Name="BotViewerCount" Width="170" Text="You have 0 viewers." FontFamily="Segoe UI Variable Display Semibold" FontSize="14" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="427,397,0,0" />

            <TextBlock Text="Minecraft Log:" FontFamily="Segoe UI Variable Display Semibold" FontSize="18" TextAlignment="Center" Margin="89,239,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

            <Border Width="268" Height="155" BorderBrush="#FF545454" BorderThickness="2" Margin="14,263,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">

                <TextBox x:Name="MinecraftLogs" BorderThickness="0" Background="White" Foreground="Black" IsReadOnly="True" IsUndoEnabled="False" UndoLimit="0" FontFamily="Consolas" FontSize="8" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            </Border>

            <TextBox x:Name="CommandTextBox" Width="195" Height="20" FontFamily="HP Simplified" FontSize="12" KeyDown="CommandTextBox_KeyDown" Margin="14,418,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

            <Button x:Name="CommandButton" Width="75" Height="20" Content="Send" Click="CommandButton_Click" FontFamily="HP Simplified" Margin="207,418,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

            <Button x:Name="Restart" Width="117" Height="51" Content="Restart" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="20" Click="RestartButton_Click" Margin="635,198,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

            <Button x:Name="Pause" Width="117" Height="51" Content="Pause" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="20" Click="PauseButton_Click" Margin="635,110,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

            <Button x:Name="Reset" Width="117" Height="51" Content="Reset" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="20" Click="ResetButton_Click" Margin="635,286,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

            <Button x:Name="Shutdown" Width="117" Height="50" Content="Shutdown" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="20" Click="ShutdownButton_Click" Margin="635,374,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Image x:Name="Gear" Height="34" Source="/Assets/Gear.png" Stretch="Fill" Width="34" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand" MouseLeftButtonDown="Help_Click" Margin="6,6,0,0" />
            <Image x:Name="Statistics" Height="34" Source="/Assets/Statistics.png" Stretch="Fill" Width="34" Cursor="Hand" MouseLeftButtonDown="Stats_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="45,6,0,0" />
        </Grid></Viewbox></Grid></UserControl>
