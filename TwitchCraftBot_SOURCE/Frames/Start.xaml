<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TwitchCraftBot_V1.Frames.Start" Background="Transparent" Foreground="White" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid ClipToBounds="True">
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,3" EndPoint="0,0">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#DD000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid Width="800" Height="450" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="True">
                <TextBlock x:Name="Title" Text="TwitchCraft" FontFamily="Cascadia Mono" FontSize="48" Foreground="Red" TextAlignment="Center" Margin="0,29,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" />

                <TextBlock x:Name="Multiplayer" Text="Multiplayer?" FontFamily="Arial Rounded MT Bold" FontSize="16" Foreground="#C6C6C6" HorizontalAlignment="Left" VerticalAlignment="Top" TextAlignment="Center" Margin="325,138,0,0" />

                <CheckBox x:Name="MultiplayerCheckbox" Checked="MultiplayerCheckbox_CheckedChanged" Unchecked="MultiplayerCheckbox_CheckedChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="459,140,0,0" />

                <TextBlock x:Name="RemoteControlStatus" Width="330" Text="REMOTE CONTROL MODE ACTIVATED" FontFamily="Arial Rounded MT Bold" FontSize="16" Foreground="#FF5555" TextAlignment="Center" Visibility="Collapsed" Margin="235,102,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <TextBlock x:Name="RemoteControlHelp" Width="360" Text="Press Ctrl + Alt + R to disable Remote Control Mode" FontFamily="Arial Rounded MT Bold" FontSize="12" Foreground="#C6C6C6" TextAlignment="Center" Visibility="Collapsed" Margin="220,124,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <TextBlock x:Name="RemoteHost" Text="Remote Host:" FontFamily="Arial Rounded MT Bold" FontSize="16" Foreground="#C6C6C6" Visibility="Collapsed" Margin="245,171,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <TextBox x:Name="RemoteHostTextbox" Width="190" Height="20" FontFamily="Arial Rounded MT Bold" FontSize="16" Visibility="Collapsed" Margin="395,171,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <TextBlock x:Name="RemoteRCONPort" Text="RCON Port:" FontFamily="Arial Rounded MT Bold" FontSize="16" Foreground="#C6C6C6" Visibility="Collapsed" Margin="245,204,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <TextBox x:Name="RemoteRCONPortTextbox" Width="190" Height="20" FontFamily="Arial Rounded MT Bold" FontSize="16" Visibility="Collapsed" Margin="395,204,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <TextBlock x:Name="RemoteRCONPassword" Text="RCON Password:" FontFamily="Arial Rounded MT Bold" FontSize="16" Foreground="#C6C6C6" Visibility="Collapsed" Margin="245,237,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <PasswordBox x:Name="RemoteRCONPasswordBox" Width="190" Height="20" FontFamily="Arial Rounded MT Bold" FontSize="16" PasswordChar="●" Visibility="Collapsed" Margin="395,237,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <TextBox x:Name="RemoteRCONPasswordTextbox" Width="190" Height="20" FontFamily="Arial Rounded MT Bold" FontSize="16" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Hidden" IsUndoEnabled="False" Visibility="Collapsed" Margin="395,237,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <CheckBox x:Name="RemoteRCONPasswordShowCheckbox" Content="Show" Foreground="#C6C6C6" FontFamily="Arial Rounded MT Bold" FontSize="12" Visibility="Collapsed" Margin="590,239,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <TextBlock x:Name="MCUser" Text="Minecraft Username:" FontFamily="Arial Rounded MT Bold" FontSize="16" Foreground="#C6C6C6" Visibility="Collapsed" Margin="205,212,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <TextBox x:Name="MCUserTextbox" Width="190" Height="20" FontFamily="Arial Rounded MT Bold" FontSize="16" Visibility="Collapsed" Margin="395,212,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <Button x:Name="StartButton" Width="116" Height="51" Content="Start" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="20" Click="StartButton_Click" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="800" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,305,0,0" />

                <Border x:Name="StartButtonDisabledOverlay" Panel.ZIndex="10" Width="116" Height="51" Background="Transparent" Visibility="Collapsed" ToolTipService.InitialShowDelay="800" Margin="342,305,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <TextBlock x:Name="OnlineMode" Text="Online Mode:" FontFamily="Arial Rounded MT Bold" FontSize="16" Foreground="#C6C6C6" Visibility="Collapsed" Margin="325,175,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <CheckBox x:Name="OnlineModeCheckbox" IsChecked="True" Visibility="Collapsed" Margin="459,177,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <Button x:Name="ImportWorldButton" Width="132" Height="30" Content="Import World" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="20" Click="ImportWorldButton_Click" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,366,0,0" />

                <TextBlock x:Name="MCVersion" Width="170" Text="Minecraft 26.1.2" FontFamily="Microsoft Sans Serif" FontSize="12" Foreground="#C6C6C6" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center" Margin="0,426,0,0" Height="14" />

                <TextBlock x:Name="BotVersion" Text="Bot Version:" FontFamily="Microsoft Sans Serif" FontSize="12" Foreground="#C6C6C6" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="682,16,0,0" />

                <Image x:Name="Gear" Width="34" Height="34" Source="/Assets/Gear.png" Stretch="Fill" Cursor="Hand" MouseLeftButtonDown="Help_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0" />
                <Image x:Name="Statistics" Width="34" Height="34" Source="/Assets/Statistics.png" Stretch="Fill" Cursor="Hand" MouseLeftButtonDown="Stats_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="51,10,0,0" />
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
