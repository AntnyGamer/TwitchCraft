<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TwitchCraftBot_V1.Frames.Help" Background="Transparent" Foreground="White" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid ClipToBounds="True">
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,3" EndPoint="0,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#DD000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><Grid Width="800" Height="450" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="True"><Button Content="Back" Width="100" Height="30" Click="Back_Click" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="20" Margin="690,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

            <TextBlock Text="HELP" FontFamily="Cascadia Mono" FontSize="36" FontWeight="Bold" Margin="0,22,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="1" />
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock FontFamily="Segoe UI Variable Display Semibold" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="34,71,0,0">
                <Hyperlink Click="OpenREADME_Click" Foreground="LightSkyBlue">
                    <Run Text="Open README.txt" />
                </Hyperlink>
            </TextBlock>

            <TextBlock FontFamily="Segoe UI Variable Display Semibold" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="34,111,0,0">
                <Hyperlink NavigateUri="https://rentry.co/bot-commands" RequestNavigate="BotCommands_RequestNavigate" Foreground="LightSkyBlue">
                    <Run Text="View Bot Commands Online" />
                </Hyperlink>
            </TextBlock>

            <TextBlock Text="SETTINGS" FontFamily="Cascadia Mono" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,164,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="1" />
                </TextBlock.Effect>
            </TextBlock>

            <Button Content="Open Settings" Width="170" Height="46" Click="OpenSettings_Click" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,214,0,0" />

            <TextBlock Text="CREDITS" FontFamily="Cascadia Mono" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,282,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="1" />
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Width="235" FontFamily="Segoe UI" FontSize="18" Foreground="#D0D0D0" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="34,317,0,0">
                <Run FontWeight="Bold" Text="CREATOR:" />
                <Run Text=" AntnyGamer" />
            </TextBlock>

            <TextBlock Width="235" FontFamily="Segoe UI" FontSize="18" Foreground="#D0D0D0" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="34,347,0,0">
                <Run FontWeight="Bold" Text="GUI DESIGN:" />
                <Run Text=" AntnyGamer" />
            </TextBlock>

            <TextBlock Width="235" FontFamily="Segoe UI" FontSize="18" Foreground="#D0D0D0" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="34,377,0,0">
                <Run FontWeight="Bold" Text="INSPIRATION:" />
                <Run Text=" Lil_KleinStein" />
            </TextBlock>

            <TextBlock Width="729" FontFamily="Segoe UI" FontSize="18" Foreground="#D0D0D0" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="34,407,0,0">
                <Run FontWeight="Bold" Text="SPECIAL THANKS:" />
                <Run Text=" All the Twitch viewers who helped test TwitchCraft and leave feedback!" />
            </TextBlock>

        </Grid></Viewbox></Grid></UserControl>
