<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace>TwitchCraftBot_V1</RootNamespace>
		<AssemblyName>TwitchCraft</AssemblyName>
		<ApplicationIcon>Assets\bot_icon.ico</ApplicationIcon>

		<AssemblyTitle>TwitchCraft</AssemblyTitle>
		<Description>Twitch viewers control your Minecraft!</Description>
		<Product>TwitchCraft</Product>
		<Copyright>© 2026 AntnyGamer. All rights reserved.</Copyright>

		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.7.1.1</FileVersion>
		<Version>1.7.1</Version>
		<NeutralLanguage>en</NeutralLanguage>
		<Authors>AntnyGamer</Authors>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Assets\server-icon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<Content Include="Assets\locateplayers\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\Background1.png" />
		<Resource Include="Assets\DiamondPickaxe.png" />
		<Resource Include="Assets\Gear.png" />
		<Resource Include="Assets\TwitchLogo.png" />
		<Resource Include="Assets\Statistics.png" />
	</ItemGroup>
</Project>
