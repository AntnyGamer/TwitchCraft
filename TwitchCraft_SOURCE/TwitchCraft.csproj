<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<UseWPF>true</UseWPF>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>

		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<RootNamespace>TwitchCraft_V1</RootNamespace>
		<AssemblyName>TwitchCraft</AssemblyName>
		<ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>

		<AssemblyTitle>TwitchCraft</AssemblyTitle>
		<Description>Twitch viewers control your Minecraft!</Description>
		<Product>TwitchCraft</Product>
		<Authors>AntnyGamer</Authors>
		<Copyright>© 2026 AntnyGamer. Licensed under AGPL v3.</Copyright>
		<RepositoryUrl>https://github.com/AntnyGamer/TwitchCraft</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<Version>1.9.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.9.0.0</FileVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="TwitchCraft.Tests" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\Background1.png" />
		<Resource Include="Assets\DiamondPickaxe.png" />
		<Resource Include="Assets\Gear.png" />
		<Resource Include="Assets\Statistics.png" />
		<Resource Include="Assets\TwitchLogo.png" />
		<EmbeddedResource Include="Assets\locateplayers\**\*">
			<LogicalName>TwitchCraft.locateplayers/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Assets\server-icon.png" LogicalName="TwitchCraft.server-icon.png" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Assets\README.txt" TargetPath="README.txt" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\LICEN?E;..\THIRD-PARTY-NOTICES.tx?" LinkBase="licenses" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
