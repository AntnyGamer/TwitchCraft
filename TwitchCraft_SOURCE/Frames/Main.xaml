<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TwitchCraft_V1.Frames.Main" Background="Transparent" Foreground="White" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid ClipToBounds="True">
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush x:Name="Fade" StartPoint="0,3" EndPoint="0,0">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#DD000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid Width="800" Height="450" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="True">
                <Image Opacity="0.5" Width="58" Stretch="Fill" Source="/Assets/TwitchLogo.png" Height="58" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="258,86,0,0">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform />
                            <SkewTransform />
                            <RotateTransform Angle="35" />
                            <TranslateTransform />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Image Width="59" Opacity="0.5" Stretch="Fill" Source="/Assets/DiamondPickaxe.png" Height="58" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="268,263,0,0">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="-1" />
                            <SkewTransform />
                            <RotateTransform Angle="20" />
                            <TranslateTransform />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>

                <Rectangle Width="121" Height="57" Fill="#FFA4A4A4" Margin="635,88,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Rectangle Width="121" Height="57" Fill="#FFA4A4A4" Margin="635,176,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Rectangle Width="121" Height="57" Fill="#FFA4A4A4" Margin="635,264,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Rectangle Width="121" Height="57" Fill="#FFA4A4A4" Margin="635,352,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <TextBlock FontFamily="Cascadia Mono" FontSize="30" Text="TwitchCraft" Foreground="#FFFF1B1B" Margin="0,16,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="1" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Text="Created by AntnyGamer" FontFamily="Arial Rounded MT Bold" FontSize="14" Foreground="#C6C6C6" Margin="623,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <TextBlock Text="Twitch Log:" Width="268" FontFamily="Arial Rounded MT Bold" FontSize="18" TextAlignment="Center" Margin="14,55,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <Border x:Name="ConnectionHealthPanel" Width="181" Height="44" Background="Transparent" BorderBrush="#FF545454" BorderThickness="1" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="395,84,0,0">
                    <StackPanel Margin="4,3,4,3">
                        <TextBlock x:Name="TwitchConnectionHealth" Text="Twitch: Connecting" FontFamily="Arial Rounded MT Bold" FontSize="12" TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="MinecraftConnectionHealth" Text="Minecraft: Starting" FontFamily="Arial Rounded MT Bold" FontSize="12" TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <Border Width="268" Height="155" BorderBrush="#FF545454" BorderThickness="2" Margin="14,79,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">

                    <TextBox x:Name="TwitchLogs" KeyboardNavigation.TabIndex="3" AutomationProperties.Name="Twitch Log" BorderThickness="0" Background="#F0F0F0" Foreground="Black" IsReadOnly="True" IsUndoEnabled="False" UndoLimit="0" FontFamily="Consolas" FontSize="8" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Border>

                <TextBlock x:Name="TwitchViewers" Width="181" Text="Twitch Viewer List:" FontFamily="Arial Rounded MT Bold" FontSize="14" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="395,138,0,0" />

                <Border Width="180" Height="230" BorderBrush="#FF545454" BorderThickness="1" Background="White" Padding="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="395,162,0,0">

                    <ListBox x:Name="BotViewerList" KeyboardNavigation.TabIndex="4" AutomationProperties.Name="Twitch Viewer List" BorderBrush="#FF545454" BorderThickness="2" Background="Transparent" FontFamily="Consolas" FontSize="12" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" Margin="-3,-3,-3,-3" />
                </Border>

                <TextBlock x:Name="BotViewerCount" Width="181" Text="You have 0 viewers." FontFamily="Arial Rounded MT Bold" FontSize="14" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="395,397,0,0" />

                <TextBlock Text="Minecraft Log:" Width="268" FontFamily="Arial Rounded MT Bold" FontSize="18" TextAlignment="Center" Margin="14,239,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <Border Width="268" Height="155" BorderBrush="#FF545454" BorderThickness="2" Margin="14,263,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">

                    <TextBox x:Name="MinecraftLogs" KeyboardNavigation.TabIndex="5" AutomationProperties.Name="Minecraft Log" BorderThickness="0" Background="White" Foreground="Black" IsReadOnly="True" IsUndoEnabled="False" UndoLimit="0" FontFamily="Consolas" FontSize="8" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Border>

                <TextBox x:Name="CommandTextBox" KeyboardNavigation.TabIndex="6" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Minecraft Command" Width="195" Height="20" FontFamily="Consolas" FontSize="12" KeyDown="CommandBox_KeyDown" Margin="14,418,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="#595959" BorderThickness="1" />

                <Button x:Name="CommandButton" KeyboardNavigation.TabIndex="7" ToolTipService.ShowOnDisabled="True" Width="75" Height="20" Content="Send" Click="SendCommand_Click" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="13" Margin="207,418,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="#595959" BorderThickness="1" />

                <Button x:Name="Restart" KeyboardNavigation.TabIndex="9" ToolTipService.ShowOnDisabled="True" Width="117" Height="51" Content="Restart" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="20" Click="Restart_Click" Margin="635,176,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <Button x:Name="Pause" KeyboardNavigation.TabIndex="8" ToolTipService.ShowOnDisabled="True" Width="117" Height="51" Content="Pause" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="20" Click="Pause_Click" Margin="635,88,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <Button x:Name="Reset" KeyboardNavigation.TabIndex="10" ToolTipService.ShowOnDisabled="True" Width="117" Height="51" Content="Reset" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="20" Click="Reset_Click" Margin="635,264,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <Button x:Name="Shutdown" KeyboardNavigation.TabIndex="11" ToolTipService.ShowOnDisabled="True" Width="117" Height="51" Content="Shutdown" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="20" Click="Shutdown_Click" Margin="635,352,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Button x:Name="Gear" KeyboardNavigation.TabIndex="0" Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="Settings" AutomationProperties.Name="Settings" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0">
                    <Image Width="34" Height="34" Source="/Assets/Gear.png" Stretch="Fill" />
                </Button>
                <Button x:Name="Statistics" KeyboardNavigation.TabIndex="1" Style="{StaticResource IconButton}" Click="Stats_Click" ToolTip="Statistics" AutomationProperties.Name="Statistics" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="51,10,0,0">
                    <Image Width="34" Height="34" Source="/Assets/Statistics.png" Stretch="Fill" />
                </Button>
                <Button KeyboardNavigation.TabIndex="2" Style="{StaticResource HelpIconButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="90,10,0,0" />
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
