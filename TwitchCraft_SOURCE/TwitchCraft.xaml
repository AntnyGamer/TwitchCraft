<Window x:Class="TwitchCraft_V1.TwitchCraft"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Frames="clr-namespace:TwitchCraft_V1.Frames"
        mc:Ignorable="d"
        Title="TwitchCraft by AntnyGamer — Viewers control your Minecraft"
        Height="450"
        Width="800"
        MinHeight="450"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#171717"
        Foreground="White"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Help" CanExecute="Help_CanExecute" Executed="Help_Executed" />
    </Window.CommandBindings>
    <Grid x:Name="WindowContentHost" ClipToBounds="True">
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Background1.png" Stretch="Fill" />
        </Grid.Background>
        <Frames:Setup x:Name="Setup" Visibility="Collapsed" />
        <Frames:Main x:Name="Main" Visibility="Collapsed" />
        <Frames:Start x:Name="Start" Visibility="Collapsed" />
    </Grid>
</Window>
